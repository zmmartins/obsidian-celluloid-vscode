  "tokenColors": [
    {
      "name": "Obsidian text",
      "scope": [
        "variable",
        "meta.embedded",
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#0C0C0E",
        "fontStyle": ""
      }
    },
    {
      "name": "Filmic comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6B4D47",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vermilion keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C00007",
        "fontStyle": ""
      }
    },
    {
      "name": "Neutral operators",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
