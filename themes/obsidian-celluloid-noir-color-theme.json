  "tokenColors": [
    {
      "name": "Obsidian text",
      "scope": [
        "variable",
        "meta.embedded",
        "source",
        "text"
      ],
      "settings": {
        "foreground": "#F4F4F6",
        "fontStyle": ""
      }
    },
    {
      "name": "Filmic comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8E8D98",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vermilion keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FF3B30",
        "fontStyle": ""
      }
    },
    {
      "name": "Neutral operators",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#A1A1AA",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#FF3B30",
        "fontStyle": ""
      }
    },
    {
      "name": "Cinema strings",
      "scope": [
